# Local development example; DO NOT put credentials in this file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./backend/pace.db
CORS_ORIGINS=http://localhost:5173,https://pace-ensemble.netlify.app
AI_PROVIDER=disabled
# AI_PROVIDER=ollama for local Ollama; AI_PROVIDER=local for original actors/critics.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
HF_SPACE_ID=
HF_TOKEN=
AI_TIMEOUT_SECONDS=90
MAX_NEW_TOKENS=128
MAX_UPLOAD_BYTES=8388608
MAX_PDF_PAGES=80
MAX_PDF_TEXT_CHARS=100000
RATE_LIMIT_PER_MINUTE=30
SANDBOX_ENABLED=false
SANDBOX_IMAGE=pace-sandbox:local
TOKENIZER_BACKEND=python
LOG_LEVEL=INFO
