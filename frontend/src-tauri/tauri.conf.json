{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PACE AI Workspaces",
  "version": "0.2.0",
  "identifier": "app.pace.workspaces",
  "build": {
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -- --mode desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PACE AI Workspaces",
        "width": 1200,
        "height": 800,
        "minWidth": 780,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://pace-phase2-api.onrender.com http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/pace-api"
    ]
  }
}
