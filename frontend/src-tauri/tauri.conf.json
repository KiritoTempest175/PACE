{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PACE",
  "version": "0.5.0",
  "identifier": "app.pace.workspaces",
  "build": {
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -- --mode desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PACE — Pipelined Actor-Critic Ensemble",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 550,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "externalBin": [
      "binaries/pace-api"
    ],
    "resources": {
      "../../desktop/README_LOCAL.md": "help/LOCAL_SETUP.md",
      "../../desktop/README.md": "help/DESKTOP_README.md"
    }
  }
}
